rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isWorkspaceMember(wid) {
      return isAuthed()
        && request.auth.token.workspaceId == wid;
    }

    match /users/{uid} {
      allow read: if isAuthed() && request.auth.uid == uid;
      allow write: if false;
    }

    match /workspaces/{wid} {
      allow read: if isWorkspaceMember(wid);
      allow write: if false;
    }

    match /workspaces/{wid}/insights/{docId} {
      allow read: if isWorkspaceMember(wid);
      allow write: if false;
    }

    match /sessions/{sessionId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow write: if false;

      match /members/{memberId} {
        // Server (Admin SDK) bypasses these rules.
        // These rules protect against direct client SDK access.
        allow read: if request.auth != null
                    && request.auth.uid == memberId;
        allow write: if false;
      }
    }

    match /feedback/{id} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow write: if false;
    }

    match /comments/{id} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow write: if false;
    }

    // ✅ ADD THIS BLOCK (CRITICAL FIX)
    match /screenshots/{id} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}