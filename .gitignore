# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Firebase service account key (never commit)
serviceAccountKey.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# extension build source maps (dev-only, never packaged/committed)
echly-extension/*.map
echly-extension/widget/**/*.map

# parallel localhost build output (generated by build:extension:local)
/annote-extension-local/

# parallel production build output (generated by build:extension:dist)
/annote-extension-dist/
