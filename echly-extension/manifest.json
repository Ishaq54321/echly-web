{
  "manifest_version": 3,
  "name": "Annote",
  "version": "1.0",
  "description": "Capture screenshots and submit feedback",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": ["activeTab", "storage", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Annote",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bootstrap.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.css",
        "widget.js",
        "assets/*",
        "fonts/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
