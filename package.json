{
  "name": "annote",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "annote-extension"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:blog": "node scripts/seedBlog.mjs",
    "build:extension": "npm run build:extension:css && npm run build:extension:js",
    "build:extension:css": "npx postcss app/globals.css -o annote-extension/popup.css && node -e \"const fs=require('fs'); const f=fs.readFileSync('annote-extension/extension-fonts.css','utf8'); const m=fs.readFileSync('annote-extension/popup.css','utf8'); fs.writeFileSync('annote-extension/popup.css', f+m);\"",
    "build:extension:js": "node esbuild-extension.mjs",
    "build:extension:prod": "cross-env NODE_ENV=production ECHLY_WEB_APP_URL=https://annote.ai npm run build:extension",
    "build:extension:dist": "cross-env NODE_ENV=production ECHLY_WEB_APP_URL=https://annote.ai ECHLY_EXT_OUT_DIR=annote-extension-dist npm run build:extension",
    "build:extension:local": "cross-env NODE_ENV=development ECHLY_WEB_APP_URL=http://localhost:3000 ECHLY_EXT_OUT_DIR=annote-extension-local npm run build:extension",
    "test:shared": "node --import tsx --test annote-extension/src/shared/privacy.test.ts annote-extension/src/shared/captureGate.test.ts",
    "test:console": "node --import tsx --test annote-extension/src/console/redact.test.ts annote-extension/src/console/stringify.test.ts annote-extension/src/console/denylist.test.ts annote-extension/src/console/buffer.test.ts",
    "test:network": "node --import tsx --test annote-extension/src/network/redactNetwork.test.ts annote-extension/src/network/buffer.test.ts annote-extension/src/network/denylist.test.ts annote-extension/src/network/resourceTiming.test.ts",
    "test:actions": "node --import tsx --test annote-extension/src/actions/redactAction.test.ts annote-extension/src/actions/buffer.test.ts annote-extension/src/actions/denylist.test.ts",
    "test:capture": "node --import tsx --test lib/captureContext.test.ts lib/sensitiveText.test.ts lib/sttVocabulary.test.ts components/CaptureWidget/session/sessionMode.test.ts",
    "test:extension": "npm run test:shared && npm run test:console && npm run test:network && npm run test:actions && npm run test:capture"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.63",
    "@next/third-parties": "16.2.9",
    "@portabletext/react": "^6.2.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.4.0",
    "@tiptap/core": "^3.23.5",
    "@tiptap/extension-code-block": "3.23.5",
    "@tiptap/extension-color": "^3.23.1",
    "@tiptap/extension-highlight": "^3.23.1",
    "@tiptap/extension-image": "^3.23.1",
    "@tiptap/extension-link": "^3.23.1",
    "@tiptap/extension-mention": "^3.22.4",
    "@tiptap/extension-placeholder": "^3.22.4",
    "@tiptap/extension-subscript": "^3.23.1",
    "@tiptap/extension-superscript": "^3.23.1",
    "@tiptap/extension-task-item": "^3.23.1",
    "@tiptap/extension-task-list": "^3.23.1",
    "@tiptap/extension-text-style": "^3.23.1",
    "@tiptap/extension-underline": "^3.23.1",
    "@tiptap/pm": "^3.23.5",
    "@tiptap/react": "^3.23.5",
    "@tiptap/starter-kit": "^3.23.5",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.177",
    "date-fns": "^4.1.0",
    "emoji-picker-react": "^4.18.0",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.7.0",
    "framer-motion": "^12.35.2",
    "heic-convert": "^2.1.0",
    "jose": "^6.0.11",
    "konva": "^10.2.5",
    "lucide-react": "^0.575.0",
    "marked": "^18.0.3",
    "nanoid": "^5.1.9",
    "next": "16.2.9",
    "next-sanity": "^13.1.1",
    "next-themes": "^0.4.6",
    "openai": "^6.25.0",
    "react": "19.2.3",
    "react-colorful": "^5.7.0",
    "react-countup": "^6.5.3",
    "react-dom": "19.2.3",
    "react-konva": "^19.2.3",
    "resend": "^6.12.0",
    "sanity": "^6.4.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "stripe": "^22.1.1",
    "styled-components": "^6.4.3",
    "tiptap-markdown": "^0.9.0",
    "use-image": "^1.1.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4",
    "@types/chrome": "^0.1.37",
    "@types/express": "^5.0.6",
    "@types/marked": "^5.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "esbuild": "^0.24.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "playwright": "^1.61.0",
    "postcss-cli": "^11.0.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
