# Local development only — never set ENABLE_DEBUG_UID or ALLOWED_DEBUG_UIDS on
# production, staging, or preview deployments (e.g. Vercel environment variables).

# ENABLE_DEBUG_UID=true
# ALLOWED_DEBUG_UIDS=your-firebase-uid-here

# Firebase Admin (server): must match Project settings → Storage bucket (default bucket is <project-id>.appspot.com).
# FIREBASE_STORAGE_BUCKET=echly-b74cc.appspot.com

# Client: must match `storageBucket` in `lib/firebase/config.ts` (used by `buildPublicScreenshotUrl`).
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=echly-b74cc.firebasestorage.app

# Cron job authorization secret — pass as Authorization: Bearer <secret> from Vercel Cron.
# CRON_SECRET=your-secret-here

# Resend — transactional email (workspace invites, deletion confirmations).
# RESEND_API_KEY=re_xxxx

# EMAIL_DEV_LOG — set to "true" to log emails to the console instead of sending
# (ignored in production for safety). Leave unset to send real emails.
# EMAIL_DEV_LOG=true

# Public app URL — used in email links (no trailing slash).
# NEXT_PUBLIC_APP_URL=https://annote.ai

# Unsubscribe link signing secret — HMAC key for one-click unsubscribe tokens.
# Without it, tokens fall back to a known dev-only secret (insecure: anyone
# could forge unsubscribe links). Generate with: openssl rand -hex 32
# UNSUBSCRIBE_SECRET=

# Paddle — payment processing (per-seat billing).
# Switch providers (default: paddle). Currently only 'paddle' is supported.
# PAYMENT_PROVIDER=paddle

# Paddle environment: 'sandbox' or 'production'.
# PADDLE_ENVIRONMENT=sandbox

# Client-side: which Paddle dashboard environment (sandbox vs production).
# Used to build admin UI deep links. Mirror this with PADDLE_ENVIRONMENT.
# NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# Server API key — Paddle Dashboard → Developer Tools → Authentication.
# Format: pdl_sdbx_apikey_... (sandbox) or pdl_live_apikey_... (production).
# PADDLE_API_KEY=

# Notification webhook secret — Paddle Dashboard → Notifications → your destination.
# Format: pdl_ntfset_...
# PADDLE_WEBHOOK_SECRET=

# Paddle price IDs — Paddle Dashboard → Catalog → Prices (format: pri_...).
# PADDLE_BUSINESS_PRICE_MONTHLY_ID=pri_...
# PADDLE_BUSINESS_PRICE_ANNUAL_ID=pri_...

# Client-side Paddle.js token — required for the overlay checkout to load.
# Format: live_... or test_...
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
