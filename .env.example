# Local development only — never set ENABLE_DEBUG_UID or ALLOWED_DEBUG_UIDS on
# production, staging, or preview deployments (e.g. Vercel environment variables).

# ENABLE_DEBUG_UID=true
# ALLOWED_DEBUG_UIDS=your-firebase-uid-here

# Firebase Admin (server): must match Project settings → Storage bucket (default bucket is <project-id>.appspot.com).
# FIREBASE_STORAGE_BUCKET=echly-b74cc.appspot.com

# Client: must match `storageBucket` in `lib/firebase/config.ts` (used by `buildPublicScreenshotUrl`).
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=echly-b74cc.firebasestorage.app

# Cron job authorization secret — pass as Authorization: Bearer <secret> from Vercel Cron.
# CRON_SECRET=your-secret-here

# Resend — transactional email (workspace invites, deletion confirmations).
# RESEND_API_KEY=re_xxxx

# Public app URL — used in email links (no trailing slash).
# NEXT_PUBLIC_APP_URL=https://echly.com

# Stripe — payment processing (per-seat billing).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_...
# STRIPE_BUSINESS_ANNUAL_PRICE_ID=price_...
