{
  "manifest_version": 3,
  "name": "Annote (Local Dev)",
  "version": "1.0",
  "version_name": "1.0-local",
  "description": "Capture feedback in a click.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": ["activeTab", "storage", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Annote (Local)",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bootstrap.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["mainWorld.js", "mainWorldNetwork.js", "mainWorldActions.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.css",
        "widget/widget.js",
        "widget/chunks/*",
        "assets/*",
        "fonts/*",
        "mainWorld.js",
        "mainWorldNetwork.js",
        "mainWorldActions.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
